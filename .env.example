# Long random secret the Reporting Agent must send as "Authorization: Bearer <secret>"
# when POSTing to /api/reports/publish. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REPORTS_PUBLISH_SECRET=replace-with-a-long-random-secret

# Auto-populated by Vercel once you connect a Blob store to this project
# (Storage tab -> Create Database -> Blob -> Connect Project). Don't set manually.
BLOB_READ_WRITE_TOKEN=
